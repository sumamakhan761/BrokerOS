# ============================================================
# Root .gitignore — BrokerOS monorepo
# ============================================================

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Environment files — NEVER commit real secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Monorepo: node_modules at every level
node_modules/
apps/*/node_modules/
packages/*/node_modules/
integrations/*/node_modules/

# Build outputs
apps/api/dist/
apps/web/.next/
apps/mobile/.expo/
apps/workers/dist/

# pnpm
.pnpm-store/

# Turbo cache
.turbo/

# Docs
/docs/All-about-system/