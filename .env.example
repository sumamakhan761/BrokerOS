# =============================================================
# BrokerOS — Monorepo Root Environment Variables (.env.example)
# =============================================================
# This file is the MASTER template for heavy infrastructure.
# Copy this file to `.env` in the root directory.
# =============================================================

# -------------------------------------------------------------
# 1. DATABASE
# -------------------------------------------------------------
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# -------------------------------------------------------------
# 2. REDIS (BullMQ Workers & Job Queues)
# -------------------------------------------------------------
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
# Or single connection URL:
REDIS_URL="redis://127.0.0.1:6379"

# -------------------------------------------------------------
# 3. AUTHENTICATION (Better Auth)
# -------------------------------------------------------------
# Generate 64-char hex secret: openssl rand -hex 32
BETTER_AUTH_SECRET="your-64-char-random-secret-here"
BETTER_AUTH_URL="http://localhost:3333"

# -------------------------------------------------------------
# 4. EMAIL MARKETING MASTER ENGINE (AWS SES)
# -------------------------------------------------------------
# Get IAM keys from: https://console.aws.amazon.com/iam/
# Verify domain/email at: https://console.aws.amazon.com/ses/
AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AWS_REGION="ap-south-1"
AWS_SES_FROM_EMAIL="marketing@yourdomain.com"
AWS_SES_FROM_NAME="Skyline Realty Marketing"

# -------------------------------------------------------------
# 5. FILE STORAGE (Vercel Blob)
# -------------------------------------------------------------
# Get token from: https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"

# -------------------------------------------------------------
# 6. AI INTEGRATION (Groq)
# -------------------------------------------------------------
# Get key from: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"