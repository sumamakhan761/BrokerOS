# =============================================================
# BrokerOS — Monorepo Root Environment Variables (.env.example)
# =============================================================
# This file is the MASTER template for environment variables.
# You must copy this file to `.env` in the root directory, AND 
# into the respective app/package directories as needed.
# =============================================================

# -------------------------------------------------------------
# 1. DATABASE
# -------------------------------------------------------------
# Connection string for your PostgreSQL database.
# Option A (Local): You can use the provided docker-compose.yml to spin up a local DB.
# Option B (Cloud): We highly recommend Neon (https://neon.tech/) for a free, serverless Postgres database.
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# -------------------------------------------------------------
# 2. AUTHENTICATION (Better Auth)
# -------------------------------------------------------------
# Generate a strong 64-character secret using: openssl rand -hex 32
BETTER_AUTH_SECRET="your-64-char-random-secret-here"
# The URL where your NestJS backend is running.
BETTER_AUTH_URL="http://localhost:3333"

# -------------------------------------------------------------
# 3. FILE STORAGE (Vercel Blob)
# -------------------------------------------------------------
# Used for storing RERA documents, KYC files, and chat attachments.
# Get your token from Vercel Storage: https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"

# -------------------------------------------------------------
# 4. AI INTEGRATION (Groq)
# -------------------------------------------------------------
# Used for lightning-fast AI transcription, lead scoring, and extraction.
# Get your free API key from the Groq Console: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"