# =============================================================
# BrokerOS — Monorepo Root Environment Variables
# =============================================================
# Shared variables for Database, Auth, Storage, and AI
# =============================================================

# PostgreSQL connection string
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Auth — generate a strong secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-64-char-random-secret-here
BETTER_AUTH_URL=http://localhost:3333

# Vercel Blob Storage — for file/document uploads
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here

# AI Transcription — Groq (fast, cloud, free tier): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
