# =============================================================
# BrokerOS — Workers (Background Queue) Environment Variables
# =============================================================
# Heavy infrastructure (PostgreSQL, Master AWS SES, Redis)
# are loaded from the root /.env file.
# This file is for worker-specific overrides.
# =============================================================

# Server Port for Workers microservice
PORT=3334

# Redis Queue Connection (Uses root /.env REDIS_URL if left blank)
# REDIS_URL="redis://127.0.0.1:6379"
# REDIS_HOST="127.0.0.1"
# REDIS_PORT="6379"

# Public URL of the NestJS API (for open tracking pixels & click redirection links)
API_PUBLIC_URL="http://localhost:3333"
