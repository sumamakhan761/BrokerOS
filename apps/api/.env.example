# =============================================================
# BrokerOS — API Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Shared variables (Database, Auth, AWS SES, Redis) are loaded from the Monorepo root.
# =============================================================

# Server port
PORT=3333

# Frontend Web Application URL
FRONTEND_URL="http://localhost:3000"

# For mobile: use your local machine IP (not localhost — device can't reach it)
# Format: exp://192.168.x.x:8081
MOBILE_URL="exp://192.168.x.x:8081"
