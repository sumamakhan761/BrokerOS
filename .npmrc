# Hoist Expo + React Native packages so native module resolution works in monorepo
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*@expo*
public-hoist-pattern[]=*react-navigation*
public-hoist-pattern[]=*nativewind*

# Ensure workspace packages are linked correctly
link-workspace-packages=true

# Use the global pnpm store for deduplication
shared-workspace-lockfile=true

virtual-store-dir-max-length=40
