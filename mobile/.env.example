# =============================================================
# BrokerOS — Mobile (Expo) Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit your real .env file.
# IMPORTANT: Use your machine's local IP address, NOT localhost.
# Your phone/emulator cannot reach localhost — it needs the LAN IP.
# Find your IP: ipconfig (Windows) / ifconfig (Mac/Linux)
# =============================================================

# Backend API URL — use your machine's local network IP in dev
# Example: http://192.168.1.42:3333
# For production: https://your-api-domain.com
EXPO_PUBLIC_API_URL=http://192.168.x.x:3333

# Google Maps API Key — used for location/map features in the mobile app
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android, Maps SDK for iOS
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
