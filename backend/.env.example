# =============================================================
# BrokerOS — Backend Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit your real .env file.
# =============================================================

# PostgreSQL connection string — pick ONE option:
#
# Option A — Docker Compose (recommended for local dev):
#   Uses the postgres service defined in docker-compose.yml at the root.
#   User: crm | Password: crm | DB: crm | Host: postgres (docker network name)
#   DATABASE_URL="postgresql://crm:crm@postgres:5432/crm"
#   NOTE: use 'postgres' as the host (not localhost) inside Docker.
#   If you want to connect from OUTSIDE Docker (e.g. Prisma Studio on your machine):
#   DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"
#
# Option B — Neon (cloud, free tier): https://console.neon.tech
#   Sign up → create a project → copy the connection string.
#   DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Option C — Local Postgres installed directly on your machine (no Docker):
#   DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/crm"
#
# DEFAULT for Docker Compose local dev:
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Server port
PORT=3333

# Auth — generate a strong secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-64-char-random-secret-here
BETTER_AUTH_URL=http://localhost:3333

# URLs (update for production)
FRONTEND_URL=http://localhost:3000
# For mobile: use your local machine IP (not localhost — device can't reach it)
# Format: exp://192.168.x.x:8081
MOBILE_URL=exp://192.168.x.x:8081

# Vercel Blob Storage — for file/document uploads
# Get from: https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here

# AI Transcription — Groq (fast, cloud, free tier): https://console.groq.com/keys
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
