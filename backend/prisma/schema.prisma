  fromUserId   String?
  fromUser     User?    @relation("AssignmentFrom", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User     @relation("AssignmentTo", fields: [toUserId], references: [id])
  reason       String?
  assignedById String?
  assignedBy   User?    @relation("AssignedByUser", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@index([leadId])
  @@index([toUserId])
  @@index([assignedAt])
  @@map("lead_assignment_history")
}

model LeadDistributionRule {
  id              String             @id @default(uuid())
  name            String
