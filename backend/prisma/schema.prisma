// ============================================================================
// BrokerOS — Complete Prisma Schema
// Database: PostgreSQL
// ORM: Prisma
// Version: 1.0

// Organization:
//   1. Generator & Datasource
//   2. Enums
//   3. Domain 1: Identity & Access
//   4. Domain 2: Lead & Customer Management
//   5. Domain 3: Activity & Communication (incl. WhatsApp)
//   6. Domain 4: Project & Inventory
//   7. Domain 5: Site Visit & Sales Pipeline
//   8. Domain 6: Booking & Post-Sales
//   9. Domain 7: Channel Partner & Brokerage
//  10. Domain 8: Accounts & Collections
//  11. Domain 9: Business Manager & Director
//  12. Domain 10: Internal Communication
// ============================================================================

// ─────────────────────────────────────────────
// 1. GENERATOR & DATASOURCE
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

